<?xml version="1.0" encoding="utf-8"?>
<!--
  O número grande da notificação.

  Um Chronometer de verdade, e não um texto que o app atualiza: quem conta é a
  SystemUI, a partir de um instante na base do elapsedRealtime. É por isso que
  ele segue correndo com o app fechado e a tela travada.

  As aparências de texto vêm do androidx: são as únicas que acompanham o tema
  claro e escuro do sistema dentro de uma notificação.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/rest_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <Chronometer
        android:id="@+id/rest_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textSize="30sp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <TextView
        android:id="@+id/rest_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
</LinearLayout>
